function getDatasetHealthCenterV1(){const user=requirePermission_('audit.read');return {ok:true,verifiedAt:nowIso_(),actor:user.email,datasets:['RESIDENCE_PERMIT_SERVICE_MONTHLY','PASSPORT_SERVICE_MONTHLY'].map(getDatasetHealth_)};}
function getDatasetHealth_(datasetKey){const d=getActiveDatasetContract_(datasetKey),v=d.sheet.getDataRange().getValues(),h=v[0]||[],i=Object.fromEntries(h.map((x,n)=>[x,n])),rows=v.slice(1).filter(r=>r.some(x=>String(x)!=='')),periods={},offices={},seen={};let duplicateKeys=0,blankKeys=0,invalidPeriods=0,invalidMeasures=0,totalMismatches=0,grandTotal=0;rows.forEach(r=>{const p=normalizePeriodCell_(r[i.periode]),o=String(r[i.kantor_imigrasi]||'').trim();if(!p||!o)blankKeys++;if(!/^[0-9]{4}-(0[1-9]|1[0-2])$/.test(p))invalidPeriods++;if(p)periods[p]=true;if(o)offices[o]=true;const k=p+'|'+o.toUpperCase();if(seen[k])duplicateKeys++;seen[k]=true;let computed=0;(d.contract.measures||[]).forEach(c=>{const n=Number(r[i[c]]);if(!Number.isInteger(n)||n<0)invalidMeasures++;computed+=Number.isFinite(n)?n:0;});const t=Number(r[i.total]);if(!Number.isInteger(t)||t<0||t!==computed)totalMismatches++;grandTotal+=Number.isFinite(t)?t:0;});const latestImport=getLatestImportHealth_(datasetKey),latestVerification=getLatestVerificationHealth_(datasetKey),snapshot=getLatestSnapshotHealth_(datasetKey,rows.length),issues=[];if(blankKeys)issues.push('blank_keys');if(invalidPeriods)issues.push('invalid_periods');if(invalidMeasures)issues.push('invalid_measures');if(totalMismatches)issues.push('total_mismatches');if(duplicateKeys)issues.push('duplicate_keys');if(Number(d.registryRow[d.registryIndex.row_count]||0)!==rows.length)issues.push('registry_row_count');if(!latestImport||String(latestImport.status).toUpperCase()!=='SUCCESS')issues.push('latest_import');if(!snapshot.configured)issues.push('snapshot_not_configured');else if(!snapshot.fresh)issues.push('snapshot_stale');const ps=Object.keys(periods).sort();return {datasetKey,sheetName:d.sheetName,rowCount:rows.length,periodCount:ps.length,periodRange:{min:ps[0]||'',max:ps[ps.length-1]||''},officeCount:Object.keys(offices).length,grandTotal,duplicateKeys,blankKeys,invalidPeriods,invalidMeasures,totalMismatches,registryRowCount:Number(d.registryRow[d.registryIndex.row_count]||0),latestImport,latestVerification,snapshot,issues,ok:issues.length===0};}
function getLatestImportHealth_(datasetKey){const sh=getDb_().getSheetByName(SHEETS.IMPORT_LOG),v=sh?sh.getDataRange().getValues():[],h=v[0]||[],i=Object.fromEntries(h.map((x,n)=>[x,n])),r=v.slice(1).filter(x=>String(x[i.dataset_key]||'')===datasetKey).pop();return r?{batchId:String(r[i.batch_id]||''),timestamp:String(r[i.timestamp]||''),rowCount:Number(r[i.row_count]||0),accepted:Number(r[i.accepted]||0),rejected:Number(r[i.rejected]||0),duplicates:Number(r[i.duplicates]||0),status:String(r[i.status]||'')}:null;}
function getLatestVerificationHealth_(datasetKey){const sh=getDb_().getSheetByName(SHEETS.AUDIT_LOG),v=sh?sh.getDataRange().getValues():[],h=v[0]||[],i=Object.fromEntries(h.map((x,n)=>[x,n])),r=v.slice(1).filter(x=>String(x[i.action]||'')==='DATASET_INTEGRITY_VERIFY'&&String(x[i.dataset_key]||'')===datasetKey).pop();return r?{timestamp:String(r[i.timestamp]||''),status:String(r[i.status]||''),batchId:String(r[i.batch_id]||'')}:null;}
function getLatestSnapshotHealth_(datasetKey,currentRowCount){const cfg=backupConfig_();if(!cfg.folderId)return {configured:false,fresh:false};const prefix=datasetKey==='RESIDENCE_PERMIT_SERVICE_MONTHLY'?'BACKUP_RESIDENCE_PERMIT_SERVICE_MONTHLY_':'BACKUP_PASSPORT_SERVICE_MONTHLY_',folder=DriveApp.getFolderById(cfg.folderId),files=folder.getFiles();let latest=null;while(files.hasNext()){const f=files.next();if(f.getName().indexOf(prefix)!==0)continue;if(!latest||f.getLastUpdated().getTime()>latest.getLastUpdated().getTime())latest=f;}if(!latest)return {configured:true,fresh:false};let rowCount=0,status='';try{const ss=SpreadsheetApp.openById(latest.getId()),sh=ss.getSheetByName(datasetKey),m=ss.getSheetByName('SNAPSHOT_MANIFEST');rowCount=sh?Math.max(0,sh.getLastRow()-1):0;if(m){const mv=m.getDataRange().getValues();for(let r=1;r<mv.length;r++)if(String(mv[r][0]||'')==='status')status=String(mv[r][1]||'');}}catch(e){return {configured:true,fresh:false,name:latest.getName(),spreadsheetId:latest.getId(),lastUpdated:latest.getLastUpdated().toISOString(),error:String(e&&e.message||e)};}return {configured:true,fresh:rowCount===currentRowCount&&status==='COMPLETE',name:latest.getName(),spreadsheetId:latest.getId(),lastUpdated:latest.getLastUpdated().toISOString(),rowCount,manifestStatus:status};}
